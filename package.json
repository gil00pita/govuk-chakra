{
  "name": "govuk-chakra",
  "version": "0.1.8",
  "description": "A GOV.UK-flavoured component skin for Chakra UI with React.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gil00pita/govuk-chakra.git"
  },
  "bugs": {
    "url": "https://github.com/gil00pita/govuk-chakra/issues"
  },
  "homepage": "https://github.com/gil00pita/govuk-chakra#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/lib.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./chakra": {
      "types": "./dist/types/chakra.d.ts",
      "import": "./dist/chakra.mjs",
      "require": "./dist/chakra.cjs"
    },
    "./theme": {
      "types": "./dist/types/theme-entry.d.ts",
      "import": "./dist/theme.mjs",
      "require": "./dist/theme.cjs"
    },
    "./provider": {
      "types": "./dist/types/provider-entry.d.ts",
      "import": "./dist/provider.mjs",
      "require": "./dist/provider.cjs"
    },
    "./charts": {
      "types": "./dist/types/charts-entry.d.ts",
      "import": "./dist/charts.mjs",
      "require": "./dist/charts.cjs"
    },
    "./editor": {
      "types": "./dist/types/editor-entry.d.ts",
      "import": "./dist/editor.mjs",
      "require": "./dist/editor.cjs"
    },
    "./utils": {
      "types": "./dist/types/utils-entry.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "govuk",
    "gds",
    "chakra-ui",
    "react",
    "design-system",
    "component-library"
  ],
  "dependencies": {
    "@chakra-ui/charts": "^3.37.0",
    "@chakra-ui/react": "^3.37.0",
    "react-icons": "^5.7.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "framer-motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "shiki": "^4.4.3"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite --clearScreen false",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "yarn clean:dist && vite build && yarn build:types",
    "build:types": "tsc -p tsconfig.build.json && node scripts/prepare-package.mjs",
    "package:size:check": "node scripts/check-package-size.mjs",
    "build:storybook": "storybook build",
    "prepublishOnly": "yarn build",
    "test": "vitest --project unit",
    "test:list": "vitest list --project unit --filesOnly",
    "test:run": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook",
    "visual:build": "storybook build",
    "visual:test": "yarn visual:build && playwright test",
    "visual:update": "yarn visual:build && playwright test --update-snapshots",
    "eject": "react-scripts eject",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "yarn build:storybook",
    "serve-storybook": "serve storybook-static",
    "lint": "eslint . --no-color --cache",
    "lint:fix": "eslint . --no-color --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:all": "yarn lint:fix && yarn format",
    "skill:catalog": "node scripts/generate-skill-catalog.mjs",
    "skill:catalog:check": "node scripts/generate-skill-catalog.mjs --check",
    "skill:install": "node scripts/install-skill.mjs",
    "design:open-design": "node scripts/export-open-design.mjs",
    "design:open-design:check": "node scripts/export-open-design.mjs --check",
    "test:open-design": "node --test scripts/export-open-design.test.mjs",
    "precommit": "node scripts/precommit.mjs",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@chakra-ui/charts": "^3.37.0",
    "@chakra-ui/react-mcp": "^2.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-links": "10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-onboarding": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/mcp": "^10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "chromatic": "^18.9.4",
    "chrome-devtools-mcp": "^1.9.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "framer-motion": "^13.4.0",
    "highlight.js": "^11.12.0",
    "jsdom": "30.1.0",
    "next-themes": "^0.4.6",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-doctor": "^0.9.14",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-scripts": "5.0.1",
    "recharts": "^3.10.1",
    "shiki": "^4.4.3",
    "storybook": "10.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-mcp": "^0.3.2",
    "vitest": "^5.0.1",
    "web-vitals": "^6.2.2",
    "webpack": "^5.111.1"
  },
  "packageManager": "yarn@4.18.0",
  "allowScripts": {}
}
