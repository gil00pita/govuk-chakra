#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
# Git clients may inherit a system Node instead of the version in .nvmrc.
if [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
  . "${NVM_DIR:-$HOME/.nvm}/nvm.sh" --no-use
  nvm use --silent
fi

printf '%s\n' 'Running visual regression, lint and unit tests before commit…'
# Enable terminal colours for Yarn and its checks.
unset NO_COLOR
export FORCE_COLOR=1
exec corepack yarn precommit
